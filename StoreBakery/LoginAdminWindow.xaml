<Window x:Class="StoreBakery.LoginAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:StoreBakery"
        mc:Ignorable="d"
        Title="LoginAdminWindow" Height="1080" Width="1920" WindowState="Maximized">
<Grid Background="#FFE2D8EC">
        <Border Margin="15" Background="White" Padding="30" CornerRadius="35" Width="800" Height="550" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="#FFE8D8FF" ShadowDepth="0"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Вхід як адміністратор" FontSize="36" FontWeight="Bold" Margin="0 0 0 20" Foreground="#FF5A2AA9"/>

                <Grid Margin="0 0 0 20" Height="90">
                    <Button HorizontalAlignment="Right" Click="authButtonBack" Content="Повернутися" Background="#FF673AB7" Foreground="White" Width="200" Height="40" FontSize="16" FontWeight="Bold"/>
                </Grid>
                <TextBox x:Name="textBoxLogin" materialDesign:HintAssist.Hint="Введіть логін" Style="{StaticResource MaterialDesignFloatingHintTextBox}" FontSize="24"/>
                <PasswordBox x:Name="passBox" materialDesign:HintAssist.Hint="Введіть пароль" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" FontSize="24"/>
                <Button Click ="AdminButton" Content="Увійти в систему" Background="#FF673AB7" Foreground="White" BorderBrush="#FF5B33A1" Height="56" FontSize="22" Margin="0,100,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

